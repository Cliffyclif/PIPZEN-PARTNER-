# Database
DATABASE_URL="postgresql://user:password@host:5432/pipzen_partner?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Resend
RESEND_API_KEY="re_your_api_key_here"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_unsigned_preset"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend sender (optional; defaults to "PipZen Partners <noreply@pipzen.io>")
RESEND_FROM_EMAIL=""

# CryMad CRM integration (contract 1.1). Every value is optional: while a key is
# empty, that part of the integration stays off. Test and live keys are kept
# apart; test keys only ever see partners whose email matches
# CRM_TEST_EMAIL_PATTERN (default: a "+crmtest" tag, e.g. joseph+crmtest1@pipzen.io).
CRM_BASE_URL="https://crm.crymadx.io"
CRM_PLATFORM_SLUG="pipzen"
CRM_ADMIN_BASE_URL="https://admin.pipzen.io"
# Comma-separated CRM egress IPs or CIDR ranges; empty = not enforced
CRM_ALLOWED_IPS=""

# Live keys
CRM_SECRET_API_KEY=""            # sk_live_...
CRM_WIDGET_KEY=""                # pk_live_...
CRM_IDENTITY_SIGNING_KEYS=""     # kid:secret[,kid:secret] (first one signs)
CRM_WEBHOOK_SECRETS=""           # whsec_...[,whsec_...] (all accepted during rotation)

# Test (sandbox) keys
CRM_TEST_BASE_URL=""             # defaults to CRM_BASE_URL
CRM_TEST_SECRET_API_KEY=""       # sk_test_...
CRM_TEST_WIDGET_KEY=""           # pk_test_...
CRM_TEST_IDENTITY_SIGNING_KEYS=""
CRM_TEST_WEBHOOK_SECRETS=""
CRM_TEST_EMAIL_PATTERN=""        # regular expression; default "\+crmtest[^@]*@"
